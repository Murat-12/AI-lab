# A* Search for 8-Puzzle Problem
import heapq
from itertools import count
 
start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)
 
goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)
 
# Heuristic: number of misplaced tiles (ignore blank tile 0)
def heuristic(state):
    misplaced = 0
    for i in range(9):
        if state[i] != 0 and state[i] != goal[i]:
            misplaced += 1
    return misplaced
 
# Generate all valid states by moving the blank tile
def get_neighbors(state):
    neighbors = []
    pos = state.index(0)
    moves = {
        0: [1, 3],
        1: [0, 2, 4],
        2: [1, 5],
        3: [0, 4, 6],
        4: [1, 3, 5, 7],
        5: [2, 4, 8],
        6: [3, 7],
        7: [4, 6, 8],
        8: [5, 7]
    }
 
    for next_pos in moves[pos]:
        new_state = list(state)
        new_state[pos], new_state[next_pos] = new_state[next_pos], new_state[pos]
        neighbors.append(tuple(new_state))
    return neighbors
 
# A* uses f(n) = g(n) + h(n)
def a_star(start_state):
    tie_breaker = count()
    open_list = []
    heapq.heappush(open_list, (heuristic(start_state), 0, next(tie_breaker), start_state))
 
    g_score = {start_state: 0}
    parent = {start_state: None}
    closed = set()
 
    while open_list:
        f, g, _, current = heapq.heappop(open_list)
 
        if current in closed:
            continue
 
        if current == goal:
            path = []
            while current is not None:
                path.append(current)
                current = parent[current]
            return path[::-1]
 
        closed.add(current)
 
        for neighbor in get_neighbors(current):
            tentative_g = g + 1  # Each tile move has a cost of 1
 
            if neighbor not in g_score or tentative_g < g_score[neighbor]:
                g_score[neighbor] = tentative_g
                parent[neighbor] = current
                f_score = tentative_g + heuristic(neighbor)
                heapq.heappush(open_list,
                               (f_score, tentative_g, next(tie_breaker), neighbor))
 
    return None
 
# Run A* and display the solution path
solution = a_star(start)
if solution is not None:
    for state in solution:
        print(list(state))
    print("Goal Reached!")
    print("Number of moves:", len(solution) - 1)
else:
    print("Goal not reachable")
